# Copy to .env and fill in locally. Never commit .env.
LLM_PROVIDER=openrouter

# OpenRouter (free Nemotron variant only)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=

# Nebius Token Factory: genuine Nebius keys only. Not used (onboarding requires a card).
NEBIUS_ENABLED=false
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_INPUT_USD_PER_MILLION=0
NEBIUS_OUTPUT_USD_PER_MILLION=0
NEBIUS_BUDGET_USD=0

# Shared request guards (5 decisions/episode is a hard maximum)
LLM_MAX_DECISIONS=5
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=25
LLM_MAX_REQUESTS=60

COMMITGYM_DB=data/commitgym.sqlite3
COMMITGYM_CORS=http://localhost:5173,http://127.0.0.1:5173
COMMITGYM_ACCESS_TOKEN=
COMMITGYM_PUBLIC=false
