NEBIUS_API_KEY=
# Compatibility fallback; set only one of the two key variables.
NEBIUS_TOKEN_FACTORY_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_ENABLED=false
NEBIUS_MAX_DECISIONS=5
NEBIUS_MAX_OUTPUT_TOKENS=512
NEBIUS_TIMEOUT_SECONDS=25
NEBIUS_MAX_REQUESTS=20
# Set both rates from the live model pricing before enabling paid inference.
NEBIUS_INPUT_USD_PER_MILLION=0
NEBIUS_OUTPUT_USD_PER_MILLION=0
NEBIUS_BUDGET_USD=0
COMMITGYM_DB=data/commitgym.sqlite3
COMMITGYM_CORS=http://localhost:5173,http://127.0.0.1:5173
# Required for public write endpoints. Leave empty only for loopback development.
COMMITGYM_ACCESS_TOKEN=

COMMITGYM_PUBLIC=false
