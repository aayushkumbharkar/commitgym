# Copy to .env and fill in locally. Never commit .env.

# --- LLM provider ---
# OpenRouter (free Nemotron variant):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# Or Nebius Token Factory:
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# LLM_MODEL=nvidia/Nemotron-3_5-Lightning
LLM_API_KEY=
LLM_ENABLED=false
# Legacy fallbacks, still read if LLM_* is unset. Set only one key variable:
# differing values are reported as a configuration error.
NEBIUS_API_KEY=
NEBIUS_TOKEN_FACTORY_KEY=

# Guards. ':free' OpenRouter models need no prices; requests are still capped.
LLM_MAX_DECISIONS=5
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=25
LLM_MAX_REQUESTS=20
# Paid models: set both rates from live pricing and a small positive cap before enabling.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
LLM_BUDGET_USD=0

# --- App ---
COMMITGYM_DB=data/commitgym.sqlite3
COMMITGYM_CORS=http://localhost:5173,http://127.0.0.1:5173
# Required for public write endpoints. Leave empty only for loopback development.
COMMITGYM_ACCESS_TOKEN=
COMMITGYM_PUBLIC=false
